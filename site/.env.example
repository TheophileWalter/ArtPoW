# Copy to .env and fill in, then `npm run build`.
# Network: 137 (Polygon), 80002 (Amoy testnet) or 31337 (local Anvil node).
VITE_CHAIN_ID=80002
VITE_CONTRACT=0x0000000000000000000000000000000000000000
# Optional: RPC endpoint for reads (defaults to publicnode.com's public endpoint of the network).
VITE_RPC_URL=
# Optional: block of the deployment, to list your tokens faster in the gallery (0 = scan from genesis).
VITE_DEPLOY_BLOCK=0
# WalletConnect / Reown project id (https://dashboard.reown.com). Empty: browser wallets only.
VITE_WALLETCONNECT_PROJECT_ID=
# Optional: ArtPoW relay that pays the gas of claims (default on Polygon: the project's relay).
VITE_RELAY_URL=
# Public repository of the project, linked from the footer.
VITE_SOURCE_URL=https://github.com/TheophileWalter/ArtPoW
# Gateways used to display ipfs:// and ar:// images.
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
VITE_ARWEAVE_GATEWAY=https://arweave.net/

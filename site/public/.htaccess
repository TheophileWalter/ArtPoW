RewriteEngine On

# HTTPS only. OVH shared hosting terminates TLS in front of Apache, where %{HTTPS} can stay off: test the port
# and the forwarded protocol instead, which avoids a redirect loop.
RewriteCond %{SERVER_PORT} =80
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Tell browsers to use HTTPS directly from now on (one year).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Every token's metadata links to <website>/token/<id> (external_url); show it in the gallery viewer.
# Absolute target: a relative one is resolved against the server's directory path. Assumes the site is at the root.
RewriteRule ^token/([0-9]+)/?$ /gallery.html#token=$1 [R=302,NE,L]
